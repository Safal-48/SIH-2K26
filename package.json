{
  "name": "cross-department-interoperability-platform",
  "version": "1.0.0",
  "description": "Cross-Department Service Interoperability & Orchestration Platform",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "start": "concurrently \"npm --prefix backend start\" \"npm --prefix frontend run preview\"",
    "install:all": "npm install && npm --prefix backend install && npm --prefix frontend install",
    "db:setup": "npm --prefix backend run db:setup",
    "db:seed": "npm --prefix backend run db:seed",
    "db:reset": "npm --prefix backend run db:reset",
    "test:mock": "npm --prefix backend run test:mock",
    "test:connectors": "npm --prefix backend run test:connectors",
    "test:mapper": "npm --prefix backend run test:mapper",
    "test:workflow": "npm --prefix backend run test:workflow",
    "test:all": "npm --prefix backend run test:all",
    "test": "npm --prefix backend run test:all",
    "demo": "npm --prefix backend run demo"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
